# .gitignore for CCTV AI Module

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/*.csv

# Evidence (generated at runtime)
evidence/**/*.jpg
evidence/**/*.mp4
evidence/**/*.png

# Alerts (generated at runtime)
alerts/*.jsonl

# OS
.DS_Store
Thumbs.db

# Model weights (too large for git)
*.pt
*.pth
*.onnx
*.engine

# Runtime data (generated at runtime)
data/entities.db
data/embeddings/*
data/enroll_images/*
!data/embeddings/.gitkeep
!data/enroll_images/.gitkeep
uploads/*
!uploads/.gitkeep

# Temporary files
*.tmp
*.temp

# Archives
*.zip
