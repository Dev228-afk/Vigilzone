# ── VigilZone Monolith ─────────────────────────────
# Copy this file as .env and adjust values for your environment.

# ── Django Backend ────────────────────────────────
DJANGO_DEBUG=1
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CORS_ALLOWED_ORIGINS=http://localhost:8085,http://localhost:3000

# ── AI Integration ────────────────────────────────
AI_BASE_INTERNAL=http://ai:8080
AI_WEBHOOK_SECRET=vigilzone-webhook-secret
AI_WEBHOOK_TOKEN=
PUBLIC_BASE_URL=http://backend:8000

# ── Webcam Publisher ──────────────────────────────
# WEBCAM_FALLBACK=testsrc   # "testsrc" (SMPTE bars) or "mp4" (loop video)
# FALLBACK_MP4=             # Path to mp4 file (only if WEBCAM_FALLBACK=mp4)
