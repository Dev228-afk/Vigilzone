# ---------- DEV HOSTS / PORTS ----------
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000

AI_HOST=127.0.0.1
AI_PORT=8080

UI_PORT=5000

# ---------- URLs (computed or used directly) ----------
AI_BASE_INTERNAL=http://127.0.0.1:8080

# ---------- FRONTEND (Vite) ----------
# IMPORTANT: Only VITE_* values are exposed in the client bundle.
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_ENABLE_WEBRTC=false
VITE_WEBRTC_VIEWER_BASE_URL=

# ---------- DJANGO ----------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DATABASE_URL=postgresql://vigilzone:vigilzone@localhost:5432/vigilzone
CHANNEL_LAYER_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=
REDIS_PORT=6379
AI_REDIS_URL=redis://redis:6379/0
AI_REDIS_HOST=
AI_REDIS_PORT=6379
AI_USE_REDIS_PUBLISH=1
AI_INCIDENT_CHANNEL=vigilzone.ai.incidents
MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554
AI_AUTO_REGISTER_WEBHOOK=0
AI_CONFIG_SNAPSHOT_MODE=backend_only
DEFAULT_AI_TENANT_ID=

# ---------- STREAM PREVIEW (OpenCV + MJPEG) ----------
STREAM_PREVIEW_FPS=5
STREAM_PREVIEW_MAX_WIDTH=960
STREAM_PREVIEW_JPEG_QUALITY=70
STREAM_IDLE_TTL_SECONDS=60
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;3000000
